{
  "_readme": [
    "The banned-language list for the /substack skill. Edit this file — it is meant to be yours.",
    "",
    "Each rule:",
    "  pattern  — a Python regex, matched case-insensitively",
    "  severity — ERROR (blocks, exit 1) or WARN (advisory, exit stays 0)",
    "  category — ai-tell | spelling | heuristic | mine",
    "  why      — one line, so future-you remembers the reason",
    "  spelling — only on spelling rules: 'us' rules fire when you run --spelling au,",
    "             'au' rules fire when you run --spelling us. Default is --spelling off.",
    "",
    "ADD YOUR OWN under category 'mine'. There's a worked example at the bottom —",
    "every writer has a word they've decided they never use. Put yours there."
  ],
  "version": "1.0",
  "rules": [
    { "pattern": "\\bdive (in|into)\\b", "severity": "ERROR", "category": "ai-tell", "why": "the single most common AI-generated opener" },
    { "pattern": "deep[- ]dive", "severity": "ERROR", "category": "ai-tell", "why": "same family as 'dive in'" },
    { "pattern": "let'?s dive", "severity": "ERROR", "category": "ai-tell", "why": "same family as 'dive in'" },
    { "pattern": "\\bdelv(e|es|ed|ing)\\b", "severity": "ERROR", "category": "ai-tell", "why": "the most statistically over-represented word in LLM prose" },
    { "pattern": "game[- ]?chang(e|er|ers|ing)", "severity": "ERROR", "category": "ai-tell", "why": "AI-generator favourite; almost nobody says it out loud" },
    { "pattern": "\\bunlock(s|ed|ing)?\\b", "severity": "ERROR", "category": "ai-tell", "why": "covers 'unlock your potential' / 'unlock the power' — marketing slop" },
    { "pattern": "in today'?s", "severity": "ERROR", "category": "ai-tell", "why": "covers 'in today's fast-paced world' and every variant" },
    { "pattern": "\\bfast[- ]paced\\b", "severity": "ERROR", "category": "ai-tell", "why": "AI-tell" },
    { "pattern": "\\bfurthermore\\b", "severity": "ERROR", "category": "ai-tell", "why": "AI connective — real people write 'and' or start a new sentence" },
    { "pattern": "\\bmoreover\\b", "severity": "ERROR", "category": "ai-tell", "why": "AI connective" },
    { "pattern": "\\bin conclusion\\b", "severity": "ERROR", "category": "ai-tell", "why": "AI essay closer; end on the argument instead" },
    { "pattern": "it'?s important to note", "severity": "ERROR", "category": "ai-tell", "why": "throat-clearing — say the thing" },
    { "pattern": "whether you'?(re| are) [^.\\n]{0,60}\\bor\\b", "severity": "ERROR", "category": "ai-tell", "why": "'Whether you're X, Y, or Z' — the tidiest tell there is" },
    { "pattern": "\\bleverag(e|es|ed|ing)\\b", "severity": "ERROR", "category": "ai-tell", "why": "corporate filler; 'use' is the word" },
    { "pattern": "\\bstreamlin(e|es|ed|ing)\\b", "severity": "ERROR", "category": "ai-tell", "why": "corporate filler" },
    { "pattern": "\\bempower(s|ed|ing|ment)?\\b", "severity": "ERROR", "category": "ai-tell", "why": "means nothing specific" },
    { "pattern": "\\bharness(es|ed|ing)?\\b", "severity": "ERROR", "category": "ai-tell", "why": "'harness the power of AI' — slop" },
    { "pattern": "\\bsupercharg(e|es|ed|ing)\\b", "severity": "ERROR", "category": "ai-tell", "why": "AI-tell" },
    { "pattern": "\\bseamless(ly)?\\b", "severity": "ERROR", "category": "ai-tell", "why": "AI-tell; nothing is ever actually seamless" },
    { "pattern": "\\belevat(e|es|ed|ing)\\b", "severity": "ERROR", "category": "ai-tell", "why": "'elevate your brand' — slop" },
    { "pattern": "\\beffortless(ly)?\\b", "severity": "ERROR", "category": "ai-tell", "why": "AI-tell, and usually a lie" },
    { "pattern": "\\brobust\\b", "severity": "ERROR", "category": "ai-tell", "why": "corporate filler" },
    { "pattern": "\\bsynergy\\b", "severity": "ERROR", "category": "ai-tell", "why": "corporate filler" },
    { "pattern": "\\bcomprehensive\\b", "severity": "ERROR", "category": "ai-tell", "why": "AI's favourite adjective for its own output" },
    { "pattern": "get started today", "severity": "ERROR", "category": "ai-tell", "why": "landing-page filler CTA" },
    { "pattern": "hope this (email )?finds you well", "severity": "ERROR", "category": "ai-tell", "why": "nobody has ever meant this" },
    { "pattern": "🚀", "severity": "ERROR", "category": "ai-tell", "why": "the rocket emoji is an instant AI/hype signal" },

    { "pattern": "\\b\\w+, \\w+,? (and )?\\w+[.!?]", "severity": "WARN", "category": "heuristic", "why": "a neat list of three — fine once, a tell in clusters" },
    { "pattern": "isn'?t [^.\\n]{1,40}\\. it'?s\\b", "severity": "WARN", "category": "heuristic", "why": "the 'not X, it's Y' construction — readers pattern-match it as AI" },
    { "pattern": "but here'?s the thing", "severity": "WARN", "category": "heuristic", "why": "fine once per post; a crutch after that" },
    { "pattern": "\\bjourney\\b", "severity": "WARN", "category": "ai-tell", "why": "overused; usually replaceable with what actually happened" },
    { "pattern": "\\brevolutionary\\b", "severity": "WARN", "category": "ai-tell", "why": "overclaim" },
    { "pattern": "\\bnext[- ]level\\b", "severity": "WARN", "category": "ai-tell", "why": "hype filler" },

    { "pattern": "\\borganiz", "severity": "ERROR", "category": "spelling", "spelling": "us", "why": "US spelling" },
    { "pattern": "\\bcustomiz", "severity": "ERROR", "category": "spelling", "spelling": "us", "why": "US spelling" },
    { "pattern": "\\bcolor(s|ed|ful)?\\b", "severity": "ERROR", "category": "spelling", "spelling": "us", "why": "US spelling" },
    { "pattern": "\\bbehavior", "severity": "ERROR", "category": "spelling", "spelling": "us", "why": "US spelling" },
    { "pattern": "\\banalyz", "severity": "ERROR", "category": "spelling", "spelling": "us", "why": "US spelling" },
    { "pattern": "\\boptimiz", "severity": "ERROR", "category": "spelling", "spelling": "us", "why": "US spelling" },
    { "pattern": "\\brecogniz", "severity": "ERROR", "category": "spelling", "spelling": "us", "why": "US spelling" },
    { "pattern": "\\brealiz", "severity": "ERROR", "category": "spelling", "spelling": "us", "why": "US spelling" },
    { "pattern": "\\bcenter(s|ed|ing)?\\b", "severity": "ERROR", "category": "spelling", "spelling": "us", "why": "US spelling" },
    { "pattern": "\\bfavor(s|ed|ite|ites)?\\b", "severity": "ERROR", "category": "spelling", "spelling": "us", "why": "US spelling" },

    { "pattern": "\\borganis", "severity": "ERROR", "category": "spelling", "spelling": "au", "why": "UK/AU spelling" },
    { "pattern": "\\bcolour", "severity": "ERROR", "category": "spelling", "spelling": "au", "why": "UK/AU spelling" },
    { "pattern": "\\bbehaviour", "severity": "ERROR", "category": "spelling", "spelling": "au", "why": "UK/AU spelling" },
    { "pattern": "\\banalys(e|es|ed|ing)\\b", "severity": "ERROR", "category": "spelling", "spelling": "au", "why": "UK/AU spelling" },
    { "pattern": "\\bcentre", "severity": "ERROR", "category": "spelling", "spelling": "au", "why": "UK/AU spelling" },
    { "pattern": "\\bfavour", "severity": "ERROR", "category": "spelling", "spelling": "au", "why": "UK/AU spelling" },

    { "pattern": "\\bfoo-bar-example-word\\b", "severity": "WARN", "category": "mine", "why": "EXAMPLE — replace this rule with a word YOU have decided you never write. Copy the line, change the pattern, set ERROR to block it." }
  ]
}
