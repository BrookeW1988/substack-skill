# Copy this file to .env and fill it in.
# ONLY needed for Path B (letting Claude fill the draft in your browser).
# Path A — the copy page — needs none of this.

# Your publication's subdomain. Look at your Substack URL.
SUBSTACK_PUBLICATION=yourname.substack.com

# The ONE call to action at the end of every post, and the words on it.
MY_CTA_LABEL=Join the newsletter
MY_CTA_URL=https://yourname.substack.com/subscribe

# Which spelling the language gate should police: au, us, or off
SPELLING=off
